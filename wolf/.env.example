# Wolf sign-in. Use either a plain password or a scrypt hash from `npm run hash-password -- 'your password'`.
WOLF_ADMIN_USERNAME=admin
WOLF_ADMIN_PASSWORD=change-me
# WOLF_ADMIN_PASSWORD_HASH=scrypt$...$...
# At least 24 random characters, e.g. `openssl rand -hex 32`
WOLF_SESSION_SECRET=
# Leave unset in production (cookies are Secure). Set to false only for plain-http local testing.
WOLF_COOKIE_SECURE=false

# Wolf's own data (projects, research, academics). Tables go in a "wolf" schema, so the shop's database works too.
WOLF_DATABASE_URL=postgres://clutch:clutch@localhost:5434/clutchx3d
# WOLF_DATABASE_CA_CERT=   (managed Postgres CA certificate, if any)

# ClutchX3D connection
CLUTCHX3D_API_URL=http://localhost:8080
CLUTCHX3D_ADMIN_KEY=same-value-as-ADMIN_API_KEY-in-clutchx3d
CLUTCHX3D_PUBLIC_URL=http://localhost:8080

PORT=8081

# Largest file (MB) that can be synced to the server. Files on a device have no limit. Default 50.
# WOLF_MAX_FILE_MB=50
